namespace deep_ep {

std::vector<uint8_t> get_unique_id() {
    epUniqueId id;
    EP_CHECK(epGetUniqueId(&id));
    std::vector<uint8_t> result(sizeof(epUniqueId));
    std::memcpy(result.data(), &id, sizeof(epUniqueId));
    return result;
}

int init(epComm_t* comm, const std::vector<uint8_t> &root_unique_id_val, int rank, int num_ranks) {
    epUniqueId root_unique_id;
    std::memcpy(&root_unique_id, root_unique_id_val.data(), sizeof(epUniqueId));
    EP_CHECK(epCommInitRank(comm, num_ranks, root_unique_id, rank));
    return 0;
}

int allGather(epComm_t comm, void* data, size_t size) {
    EP_CHECK(epAllGather(comm, data, size));
    return 0;
}

int destroy(epComm_t comm) {
    EP_CHECK(epCommDestroy(comm));
    return 0;
}

namespace intranode {

template<int kNumRanks>
__global__ void barrier(int** barrier_signal_ptrs, int rank, struct primitives* prims, int* cached_value_ptrs) {
    auto subthread_id = static_cast<int>(subThreadIdx.x);
    const auto channel_id = 0;
    primitives_simple prim(&prims[channel_id], subthread_id, rank);
    barrier_device<kNumRanks>(cached_value_ptrs, barrier_signal_ptrs, rank, &prim);
}

void barrier(int** barrier_signal_ptrs, int rank, int num_ranks, topsStream_t stream, struct primitives* prims, int* cached_value_ptrs) {
#define BARRIER_LAUNCH_CASE(num_ranks) \
    LAUNCH_KERNEL(&cfg, barrier<num_ranks>, barrier_signal_ptrs, rank, prims, cached_value_ptrs); \
    break

    SETUP_LAUNCH_CONFIG(1, 1, 8, stream);
    SWITCH_RANKS(BARRIER_LAUNCH_CASE);
#undef BARRIER_LAUNCH_CASE
}

} // namespace intranode

