#define ibgdaINFO ibgdaTRACE

#define unified_endpoint_print(_nRanks, _nQps, _ueps_ptr)                                  \
  unified_endpoint *ueps = reinterpret_cast<unified_endpoint*>((uintptr_t)(_ueps_ptr));    \
  for (int r = 0; r < nRanks; r++) {                                                       \
    for (int qp = 0; qp < _nQps; ++qp) {                                                   \
    RdmaEndpoint *dbgEP = reinterpret_cast<RdmaEndpoint*>(&(ueps[r * _nQps + qp]));        \
    ibgdaINFO("r%-2d qp[%-2d] %p %d psn: %d qpn: %4d ib [%d]  "                            \
           "eth [gid: %02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x, "  \
           "mac:  %02x%02x%02x%02x%02x%02x]\n",                                            \
           r, qp, dbgEP, dbgEP->GetProviderType(),                                         \
           dbgEP->handle.psn,                                                              \
           dbgEP->handle.qpn,                                                              \
           dbgEP->handle.ib.lid,                                                           \
           dbgEP->handle.eth.gid[ 0 ],                                                     \
           dbgEP->handle.eth.gid[ 1 ],                                                     \
           dbgEP->handle.eth.gid[ 2 ],                                                     \
           dbgEP->handle.eth.gid[ 3 ],                                                     \
           dbgEP->handle.eth.gid[ 4 ],                                                     \
           dbgEP->handle.eth.gid[ 5 ],                                                     \
           dbgEP->handle.eth.gid[ 6 ],                                                     \
           dbgEP->handle.eth.gid[ 7 ],                                                     \
           dbgEP->handle.eth.gid[ 8 ],                                                     \
           dbgEP->handle.eth.gid[ 9 ],                                                     \
           dbgEP->handle.eth.gid[10 ],                                                     \
           dbgEP->handle.eth.gid[11 ],                                                     \
           dbgEP->handle.eth.gid[12 ],                                                     \
           dbgEP->handle.eth.gid[13 ],                                                     \
           dbgEP->handle.eth.gid[14 ],                                                     \
           dbgEP->handle.eth.gid[15 ],                                                     \
           dbgEP->handle.eth.mac[0],                                                       \
           dbgEP->handle.eth.mac[1],                                                       \
           dbgEP->handle.eth.mac[2],                                                       \
           dbgEP->handle.eth.mac[3],                                                       \
           dbgEP->handle.eth.mac[4],                                                       \
           dbgEP->handle.eth.mac[5]);                                                      \
    (void)dbgEP;                                                                           \
    }                                                                                      \
  }


