#include "configs.h"
#include "exception.h"
#include "launch.h"
#include "primitive_simple.hpp"
#include "utils.h"
#include <krt/builtins.h>

namespace deep_ep {

namespace layout {

#define CEILDIV(lhs, rhs) (((lhs) + (rhs)-1) / (rhs))
#define ALIGNUP(size, align_size) (CEILDIV(size, align_size) * (align_size))
#define UNROLL (4)
#define BASE_NUM (32)
#define MAX_L1 (800 * 1024)
#define MAX_L2 (128 * 1024)
#define EXTRA_PAD (8 * 1024)

enum class HIS_MODE {
  BASIC = 0,
  RADIX = 1,
  SCATTER = 2,
};

__device__ __forceinline__ void histogram_basic[[maybe_unused]](int *topk_ids,
                                                int *tokens_per_expert,
                                                int e_begin, int e_end,
                                                int e_stride, int eles) {
  using VT = __vector int;
  using CT = __vector int;
  using MT = typename tcle::altivector_to_mask<CT>::type;
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  int in_stride = sizeof(VT);
  VT in[UNROLL];
  MT mask[UNROLL];
  int num[UNROLL];

  for (int e = e_begin; e < e_end; e += e_stride) {
    auto in_ptr = tcle::leaptr<VT>(
        reinterpret_cast<tcle::generic_ptr>(topk_ids), in_stride);
    for (int i = 0; i < UNROLL; i++) {
      num[i] = 0;
    }
    int total_num = 0;
    for (int i = 0; i < eles; i += UNROLL * VT_E) {
#pragma clang loop unroll(full)
      for (int j = 0; j < UNROLL; j++) {
        in[j] = in_ptr.load();
        mask[j] = in[j] == CT(e);
        num[j] += tcle::popc_mb<0>(mask[j]);
      }
    }
    for (int i = 0; i < UNROLL; i++) {
      total_num += num[i];
    }
    tokens_per_expert[e - e_begin] += total_num;
  }
}

__device__ __forceinline__ void histogram_radix[[maybe_unused]](int *topk_ids,
                                                int *tokens_per_expert,
                                                int e_begin, int e_end,
                                                int eles) {
  static_cast<void>(tokens_per_expert);
  using VT = __vector int;
  using IdxT = __vector unsigned int;
  VT vzero_s = (VT)0;
  VT in[UNROLL];
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  int in_stride = sizeof(VT);
  op_assert(eles % UNROLL * VT_E == 0, "not allowed");
  op_assert(e_begin % BASE_NUM == 0, "not allowed");
  op_assert(e_end - e_begin <= BASE_NUM, "not allowed");
  auto in_ptr = tcle::leaptr<VT>(reinterpret_cast<tcle::generic_ptr>(topk_ids),
                                 in_stride);
  for (int i = 0; i < eles; i += UNROLL * VT_E) {
#pragma clang loop unroll(full)
    for (int j = 0; j < UNROLL; j++) {
      in[j] = in_ptr.load();
      in[j] = tcle::vsel(in[j] < e_end, in[j], vzero_s);
      // we sip '=e' here on purpose
      in[j] = tcle::vsel(in[j] > e_begin, in[j], vzero_s);
      tcle::mradix_cntbase(in[j], 0);
      tcle::mradix_r_base<IdxT>();
    }
  }
}

__device__ __forceinline__ void
merge_total_and_store(int *partial_tokens_per_expert, int *tokens_per_expert,
                      int aligned_eles, int eles, int num_partial, int e_begin,
                      int e_end) {
  int act_experts = e_end - e_begin;
  using VT = vector int;
  constexpr int VT_E = sizeof(VT) / sizeof(int);

  op_assert(aligned_eles % VT_E == 0, "not_allowed");
  // long long t_start = tops::clock64();
  for (int i = 0; i < eles; i += VT_E) {
    int in_stride = aligned_eles * sizeof(int);
    auto in_ptr = tcle::leaptr<VT>(
        reinterpret_cast<tcle::generic_ptr>(partial_tokens_per_expert + i),
        in_stride);
    __builtin_assume(num_partial <= 24);
    VT out = (VT)0;
#pragma clang loop unroll(full)
    for (int j = 0; j < num_partial; j++) {
      auto in = in_ptr.load();
      out += in;
    }
    int tmp = std::max(act_experts - i, 0);
    int valid_experts = std::min(tmp, VT_E);
    tcle::set_vl(valid_experts);
    tcle::store(out, tokens_per_expert + i + e_begin);
    tcle::set_vl(TCLE_MAX_VECTOR_LENGTH);
  }
}

template <int UNROLL_K>
__device__ __forceinline__ void
scatter_is_in_expert_unroll_t(int *topk_ids, uint8_t *is_in_expert, int topk,
                              int num_tokens, int expert_begin, int expert_end,
                              int num_experts, int pad_offset) {
  static_assert(UNROLL_K * 512 <= EXTRA_PAD);
  using VT = vector4 unsigned int;
  using VUT = vector4 unsigned int;
  using IT = vector char;
  VT in[UNROLL_K];
  VT offset[UNROLL_K];
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  op_assert(num_tokens % VT_E == 0, "not allowed");
  VT vpad[UNROLL_K];
  IT vone = IT(1);

  // pad_offset + kk * 512 + [0, 1, ..., 511]
#pragma clang loop unroll(full)
  for (int kk = 0; kk < UNROLL_K; kk++) {
    vpad[kk] = tcle::mid<VT>(0) + (pad_offset + kk * 512);
  }
  for (int i = 0; i < num_tokens; i += VT_E) {
    for (int k = 0; k < topk; k += UNROLL_K) {
#pragma clang loop unroll(full)
      for (int kk = 0; kk < UNROLL_K; kk++) {
        offset[kk] = (tcle::mid<VUT>(i) * topk + k + kk) * sizeof(int);
        in[kk] = tcle::gather<VT>(topk_ids, offset[kk]);
      }
#pragma clang loop unroll(full)
      for (int kk = 0; kk < UNROLL_K; kk++) {
        offset[kk] = (tcle::mid<VUT>(i) * num_experts + in[kk] - expert_begin) *
                     static_cast<int>(sizeof(uint8_t));
        offset[kk] = tcle::vsel(in[kk] < static_cast<unsigned int>(expert_end), offset[kk], vpad[kk]);
        offset[kk] = tcle::vsel(in[kk] >= static_cast<unsigned int>(expert_begin), offset[kk], vpad[kk]);
        tcle::scatter(vone, is_in_expert, offset[kk]);
      }
    }
  }
}

template <int UNROLL_K>
__device__ __forceinline__ void
scatter_is_in_slot_unroll_t(int *topk_ids, uint8_t *is_in_slot, int topk,
                            int num_tokens, int num_slots,
                            int num_experts_per_slot, int pad_offset) {
  static_assert(UNROLL_K * 512 <= EXTRA_PAD);
  using VT = vector4 unsigned int;
  using VUT = vector4 unsigned int;
  using IT = vector char;
  VT in[UNROLL_K];
  VT offset[UNROLL_K];
  //VT vpad = VT(pad_offset);
  VT vpad[UNROLL_K];
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  op_assert(num_tokens % VT_E == 0, "not allowed");
  IT vone = IT(1);
  // pad_offset + [0, 1, ..., 511]
#pragma clang loop unroll(full)
  for (int kk = 0; kk < UNROLL_K; kk++) {
    vpad[kk] = tcle::mid<VT>(0) + (pad_offset + kk * 512);
  }
  for (int i = 0; i < num_tokens; i += VT_E) {
    for (int k = 0; k < topk; k += UNROLL_K) {
#pragma clang loop unroll(full)
      for (int kk = 0; kk < UNROLL_K; kk++) {
        offset[kk] = (tcle::mid<VUT>(i) * topk + k + kk) * sizeof(int);
        in[kk] = tcle::gather<VT>(topk_ids, offset[kk]);
      }
#pragma clang loop unroll(full)
      for (int kk = 0; kk < UNROLL_K; kk++) {
        in[kk] = in[kk] / num_experts_per_slot;
        offset[kk] = (tcle::mid<VUT>(i) * num_slots + in[kk]) *
                     static_cast<int>(sizeof(uint8_t));
        offset[kk] = tcle::vsel(in[kk] < static_cast<unsigned int>(num_slots), offset[kk], vpad[kk]);
        offset[kk] = tcle::vsel(in[kk] >= 0, offset[kk], vpad[kk]);
        tcle::scatter(vone, is_in_slot, offset[kk]);
      }
    }
  }
}

// bool_in  [num_tokens, num_ranks]
template <int UNROLL_R>
__device__ __forceinline__ void
reduce_bool_unroll(uint8_t *bool_in, int *num_tokens_per_rank, int num_tokens,
                   int num_ranks) {
  using IT = vector char;
  using VUT = vector4 unsigned int;
  IT vone = IT(1);
  using MIT = typename tcle::altivector_to_mask<IT>::type;
  constexpr int IT_E = sizeof(IT) / sizeof(char);
  VUT offset[UNROLL_R];
  IT in[UNROLL_R];
  MIT in_mask[UNROLL_R];
  int num[UNROLL_R];
  op_assert(num_ranks % UNROLL_R == 0, "not_allowed");

  for (int r = 0; r < num_ranks; r += UNROLL_R) {
    for (int rr = 0; rr < UNROLL_R; rr++) {
      num[rr] = 0;
    }
    for (int i = 0; i < num_tokens; i += IT_E) {
      VUT base_offset = tcle::mid<VUT>(i) * num_ranks;
#pragma clang loop unroll(full)
      for (int rr = 0; rr < UNROLL_R; rr++) {
        offset[rr] = base_offset + rr + r;
        in[rr] = tcle::gather<IT>(bool_in, offset[rr]);
        in_mask[rr] = (in[rr] == vone);
        num[rr] += tcle::popc_mb<0>(in_mask[rr]);
      }
    }
    for (int rr = 0; rr < UNROLL_R; rr++) {
      num_tokens_per_rank[r + rr] += num[rr];
    }
  }
}

// bool_in  [num_tokens, num_ranks]
template <int UNROLL_R>
__device__ __forceinline__ void
reduce_bool_unroll_1(uint8_t *bool_in, int *num_tokens_per_rank, int num_tokens,
                     int num_ranks) {
  using IT = vector char;
  using VT = vector int;
  // constexpr int IT_E = sizeof(IT) / sizeof(char);
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  IT in[UNROLL_R];
  IT sum[UNROLL_R];
  VT tmp[UNROLL_R];
  op_assert(num_ranks % UNROLL_R == 0, "not_allowed");
  op_assert(num_ranks <= VT_E, "not_allowed");
  op_assert(num_tokens / UNROLL_R <= 256, "not_allowed uint8 overflow");
  static_assert(UNROLL_R <= 16);

  int in_stride = num_ranks * sizeof(char);
  auto in_ptr =
      tcle::leaptr<IT>(reinterpret_cast<tcle::generic_ptr>(bool_in), in_stride);

  for (int j = 0; j < UNROLL_R; j++) {
    sum[j] = IT(0);
  }
  for (int i = 0; i < num_tokens; i += UNROLL_R) {
    tcle::set_vl(num_ranks);
#pragma clang loop unroll(full)
    for (int j = 0; j < UNROLL_R; j++) {
      in[j] = in_ptr.load();
    }
    tcle::set_vl(TCLE_MAX_VECTOR_LENGTH);
#pragma clang loop unroll(full)
    for (int j = 0; j < UNROLL_R; j++) {
      sum[j] = sum[j] + in[j];
    }
  }
  auto init_value = tcle::load<VT>(num_tokens_per_rank);

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 2; i++) {
    auto cvt = tcle::cvt<vector4 int>(sum[i]);
    auto cvt_half = tcle::cvt<vector4 int>(sum[i + UNROLL_R / 2]);
    tmp[i] = tcle::extract<VT, 0>(cvt);
    tmp[i + UNROLL_R / 2] = tcle::extract<VT, 0>(cvt_half);
    tmp[i] += tmp[i + UNROLL_R / 2];
  }

  tmp[UNROLL_R / 4 - 1] += init_value;

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 4; i++) {
    tmp[i] += tmp[i + UNROLL_R / 4];
  }

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 8; i++) {
    tmp[i] += tmp[i + UNROLL_R / 8];
  }

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 16; i++) {
    tmp[i] += tmp[i + UNROLL_R / 16];
  }

  tcle::set_vl(num_ranks);
  auto final_sum = tmp[0];
  tcle::store(final_sum, num_tokens_per_rank);
}

// bool_in  [num_tokens, num_ranks]
template <int UNROLL_R>
__device__ __forceinline__ void
reduce_bool_unroll_2(uint8_t *bool_in, int *num_tokens_per_rank, int num_tokens,
                     int num_ranks) {
  using IT = vector char;
  using VT = vector int;
  // constexpr int IT_E = sizeof(IT) / sizeof(char);
  constexpr int VT_E = sizeof(VT) / sizeof(int);
  IT in[UNROLL_R];
  IT sum[UNROLL_R];
  VT tmp[UNROLL_R];
  VT tmp1[UNROLL_R];
  op_assert(num_ranks % UNROLL_R == 0, "not_allowed");
  op_assert(num_ranks <= 2 * VT_E, "not_allowed");
  op_assert(num_tokens / UNROLL_R <= 256, "not_allowed uint8 overflow");
  static_assert(UNROLL_R <= 16);

  int in_stride = num_ranks * sizeof(char);
  auto in_ptr =
      tcle::leaptr<IT>(reinterpret_cast<tcle::generic_ptr>(bool_in), in_stride);

  for (int j = 0; j < UNROLL_R; j++) {
    sum[j] = IT(0);
  }
  for (int i = 0; i < num_tokens; i += UNROLL_R) {
// tcle::set_vl(num_ranks);
#pragma clang loop unroll(full)
    for (int j = 0; j < UNROLL_R; j++) {
      in[j] = in_ptr.load();
    }
    tcle::set_vl(TCLE_MAX_VECTOR_LENGTH);
#pragma clang loop unroll(full)
    for (int j = 0; j < UNROLL_R; j++) {
      sum[j] = sum[j] + in[j];
    }
  }
  auto init_value = tcle::load<VT>(num_tokens_per_rank);
  auto init_value1 = tcle::load<VT>(num_tokens_per_rank + VT_E);

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 2; i++) {
    auto cvt = tcle::cvt<vector4 int>(sum[i]);
    auto cvt_half = tcle::cvt<vector4 int>(sum[i + UNROLL_R / 2]);
    tmp[i] = tcle::extract<VT, 0>(cvt);
    tmp[i + UNROLL_R / 2] = tcle::extract<VT, 0>(cvt_half);
    tmp[i] += tmp[i + UNROLL_R / 2];

    tmp1[i] = tcle::extract<VT, 1>(cvt);
    tmp1[i + UNROLL_R / 2] = tcle::extract<VT, 1>(cvt_half);
    tmp1[i] += tmp1[i + UNROLL_R / 2];
  }
  tmp[UNROLL_R / 4 - 1] += init_value;
  tmp1[UNROLL_R / 4 - 1] += init_value1;

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 4; i++) {
    tmp[i] += tmp[i + UNROLL_R / 4];
    tmp1[i] += tmp1[i + UNROLL_R / 4];
  }

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 8; i++) {
    tmp[i] += tmp[i + UNROLL_R / 8];
    tmp1[i] += tmp1[i + UNROLL_R / 8];
  }

#pragma clang loop unroll(full)
  for (int i = 0; i < UNROLL_R / 16; i++) {
    tmp[i] += tmp[i + UNROLL_R / 16];
    tmp1[i] += tmp1[i + UNROLL_R / 16];
  }

  tcle::set_vl(std::min(VT_E, num_ranks));
  auto final_sum = tmp[0];
  tcle::store(final_sum, num_tokens_per_rank);
  auto final_sum1 = tmp1[0];
  tcle::set_vl(std::max(num_ranks - VT_E, 0));
  tcle::store(final_sum1, num_tokens_per_rank + VT_E);
  tcle::set_vl(TCLE_MAX_VECTOR_LENGTH);
}

template <HIS_MODE MODE, int UNROLL_K>
__device__  void handle_expert_histogram(
    char *l1_buffer, char *l2_buffer, int *topk_ids, int *num_tokens_per_expert,
    int num_tokens, int num_topk, int num_experts, tops::private_dte &in_dte,
    int block_id, int num_blocks) {
  // const int block_id = static_cast<int>(blockIdx.x);
  // const int num_blocks = static_cast<int>(gridDim.x);
  const int thread_id = static_cast<int>(threadIdx.x);
  const int num_threads = static_cast<int>(blockDim.x);
  const int sub_id = static_cast<int>(subThreadIdx.x);
  const int num_subs = static_cast<int>(threadDim.x);

  int BLOCK_E_ALIGN = 32;

  // only split experts among blocks
  int num_experts_per_block =
      ALIGNUP(((num_experts + num_blocks - 1) / num_blocks), BLOCK_E_ALIGN);
  int block_e_begin = block_id * num_experts_per_block;
  int block_e_end =
      std::min(block_e_begin + num_experts_per_block, num_experts);

  int sub_tokens = 64;
  int sub_experts = 32;
  if constexpr (MODE == HIS_MODE::SCATTER) {
    sub_tokens = 128 * 4;
    sub_experts = num_experts_per_block;
    while (sub_experts > 256) {
      sub_experts = sub_experts / 2;
    }
    sub_experts = ALIGNUP(sub_experts, 32);
  }

  // const int ele_per_oa = 128;
  // const int L1_ALIGN_NUM = ele_per_oa * UNROLL;
  const int num_topk_ids_tile = ALIGNUP(sub_tokens * num_topk, 2048);
  // const int num_topk_ids_tile = ALIGNUP(sub_tokens * num_topk, L1_ALIGN_NUM);
  const int num_experts_tile = ALIGNUP(sub_experts, 1024);
  const int num_is_in_expert_tile = sub_tokens * sub_experts;
  using IdxT = __vector unsigned int;
  IdxT vzero = (IdxT)0;
  const int THREAD_TOK_ALIGN = sub_tokens * num_subs;
  int num_tokens_per_thread =
      ALIGNUP(((num_tokens + num_threads - 1) / num_threads), THREAD_TOK_ALIGN);
  int thread_token_begin = thread_id * num_tokens_per_thread;
  int thread_token_end =
      std::min(thread_token_begin + num_tokens_per_thread, num_tokens);
  // int num_experts_per_thread = num_experts_per_block;
  int thread_e_begin = block_e_begin;
  int thread_e_end = block_e_end;
  int l1_offset = 0;

  int *l1_topk_ids_buf = reinterpret_cast<int *>(
      (l1_buffer + l1_offset) + sub_id * num_topk_ids_tile * sizeof(int));
  l1_offset += num_subs * num_topk_ids_tile * sizeof(int);

  uint8_t *l1_is_in_expert_buf = nullptr;

  if constexpr (MODE == HIS_MODE::SCATTER) {

    l1_is_in_expert_buf = reinterpret_cast<uint8_t *>(
        l1_buffer + l1_offset +
        sub_id * num_is_in_expert_tile * sizeof(uint8_t));
    l1_offset += num_subs * num_is_in_expert_tile * sizeof(uint8_t);
    // extra buffer to put masked scatter value
    l1_offset += EXTRA_PAD;
  }

  op_assert(l1_offset <= MAX_L1, "l1 buffer overflow");
  int l2_offset = 0;
  int *l2_tokens_per_expert_buf = reinterpret_cast<int *>(
      l2_buffer + l2_offset +
      (thread_id * num_subs + sub_id) * num_experts_tile * sizeof(int));
  l2_offset += num_threads * num_subs * num_experts_tile * sizeof(int);
  op_assert(l2_offset <= MAX_L2, "l2 buffer overflow");

  tops::mdspan l1_topk_ids(tops::Local, l1_topk_ids_buf, num_topk_ids_tile);
  tops::mdspan l1_is_in_expert(tops::Local, l1_is_in_expert_buf,
                               num_is_in_expert_tile);

  tops::mdspan l2_num_tokens_per_expert(tops::Shared, l2_tokens_per_expert_buf,
                                        num_experts_tile);
  tops::mdspan l3_topk_ids(tops::Global, topk_ids, num_tokens * num_topk);
  tops::memset(in_dte, l2_num_tokens_per_expert, 0);

  for (int expert_offset = thread_e_begin; expert_offset < thread_e_end;
       expert_offset += sub_experts) {
    int expert_end = std::min(expert_offset + sub_experts, thread_e_end);
    tops::memset(in_dte, l2_num_tokens_per_expert, 0);
    if constexpr (MODE == HIS_MODE::RADIX) {
      if (sub_id == 0) {
        tcle::mradix_w_base(vzero);
      }
      __syncsubthreads();
    }

    for (int token_offset = thread_token_begin + sub_id * sub_tokens;
         token_offset < thread_token_end;
         token_offset += num_subs * sub_tokens) {
      int act_tokens = std::min(thread_token_end - token_offset, sub_tokens);
      int pad_value = -1;

      // L1_VDMEM_LOAD
      tcle::fence<0x52>();
      if constexpr (MODE == HIS_MODE::SCATTER) {
        tops::memset(in_dte, l1_is_in_expert, 0);
      }
      tops::memset(in_dte, l1_topk_ids, pad_value);
      tops::mdspan l1_topk_ids_act(tops::Local, l1_topk_ids_buf,
                                   act_tokens * num_topk);
      tops::mdspan l3_topk_ids_act(tops::Global,
                                   topk_ids + token_offset * num_topk,
                                   act_tokens * num_topk);
      tops::memcpy(in_dte, l1_topk_ids_act, l3_topk_ids_act);

      if constexpr (MODE == HIS_MODE::RADIX) {
        histogram_radix(l1_topk_ids_buf, l2_tokens_per_expert_buf,
                        expert_offset, expert_end, num_topk_ids_tile);
        // call histogram_basic to deal with e that e % BASE_NUM == 0
        histogram_basic(l1_topk_ids_buf, l2_tokens_per_expert_buf,
                        expert_offset, expert_end, BASE_NUM, num_topk_ids_tile);
      } else if constexpr (MODE == HIS_MODE::BASIC) {
        histogram_basic(l1_topk_ids_buf, l2_tokens_per_expert_buf,
                        expert_offset, expert_end, 1, num_topk_ids_tile);
      } else {

        int pad_offset =
            ((num_subs - sub_id) * num_is_in_expert_tile) * sizeof(uint8_t);
        scatter_is_in_expert_unroll_t<UNROLL_K>(
            l1_topk_ids_buf, l1_is_in_expert_buf, num_topk, sub_tokens,
            expert_offset, expert_end, sub_experts, pad_offset);
        if (sub_experts <= 128) {
          reduce_bool_unroll_1<16>(l1_is_in_expert_buf,
                                   l2_tokens_per_expert_buf, sub_tokens,
                                   sub_experts);
        } else {
          reduce_bool_unroll_2<16>(l1_is_in_expert_buf,
                                   l2_tokens_per_expert_buf, sub_tokens,
                                   sub_experts);
        }
      }
    }
    if constexpr (MODE == HIS_MODE::RADIX) {
      __syncsubthreads();
      if (sub_id == 0) {
        IdxT BASE = tcle::mradix_r_base<IdxT>();
        // we sip 'base_i = 0' here on purpose
        for (int base_i = 1; base_i < BASE_NUM; base_i++) {
          l2_tokens_per_expert_buf[base_i] += BASE[base_i];
        }
      }
    }
    __syncthreads();
    // merge among threads
    if (thread_id == 0 && sub_id == 0) {
      merge_total_and_store(l2_tokens_per_expert_buf, num_tokens_per_expert,
                            num_experts_tile, sub_experts,
                            num_subs * num_threads, expert_offset, expert_end);
    }
    // L2_MEM_LOAD
    tcle::fence<0x54>();
    tops::sync_block_threads();
  }
}

template <bool STORE_IS_IN_RANK, int UNROLL_K, int UNROLL_R>
__device__ void
handle_rank(char *l1_buffer, char *l2_buffer, int *topk_ids,
            int *num_tokens_per_rank, bool *is_token_in_rank, int num_tokens,
            int num_topk, int num_experts, int num_ranks,
            tops::private_dte &in_dte, int block_id, int num_blocks) {
  static_assert(sizeof(bool) == 1);
  // split tokens among all threads
  const int total_thread_id =
      block_id * static_cast<int>(blockDim.x) + static_cast<int>(threadIdx.x);
  const int num_total_threads = num_blocks * static_cast<int>(blockDim.x);
  const int thread_id = static_cast<int>(threadIdx.x);
  const int num_threads = static_cast<int>(blockDim.x);
  const int sub_id = static_cast<int>(subThreadIdx.x);
  const int num_subs = static_cast<int>(threadDim.x);
  const int sub_tokens = 128 * 4;
  const int THREAD_TOK_ALIGN = sub_tokens * num_subs;
  int num_tokens_per_thread =
      ALIGNUP(((num_tokens + num_total_threads - 1) / num_total_threads),
              THREAD_TOK_ALIGN);
  int thread_token_begin = total_thread_id * num_tokens_per_thread;
  int thread_token_end =
      std::min(thread_token_begin + num_tokens_per_thread, num_tokens);

  // const int ele_per_oa = 128;
  // const int L1_ALIGN_NUM = ele_per_oa * UNROLL;
  const int num_topk_ids_tile = ALIGNUP(sub_tokens * num_topk, 1024);
  const int num_is_in_rank_tile = sub_tokens * num_ranks;
  const int num_tokens_per_rank_tile = ALIGNUP(num_ranks, 1024);

  int l1_offset = 0;
  int *l1_topk_ids_buf = reinterpret_cast<int *>(
      l1_buffer + l1_offset + sub_id * num_topk_ids_tile * sizeof(int));
  l1_offset += num_subs * num_topk_ids_tile * sizeof(int);

  uint8_t *l1_is_in_rank_buf = reinterpret_cast<uint8_t *>(
      l1_buffer + l1_offset + sub_id * num_is_in_rank_tile * sizeof(uint8_t));
  l1_offset += num_subs * num_is_in_rank_tile * sizeof(uint8_t);
  // extra buffer to put masked scatter value
  l1_offset += EXTRA_PAD;

  int l2_offset = 0;
  int *l2_tokens_per_rank_buf = reinterpret_cast<int *>(
      l2_buffer + l2_offset +
      (thread_id * num_subs + sub_id) * num_tokens_per_rank_tile * sizeof(int));

  l2_offset += num_threads * num_subs * num_tokens_per_rank_tile * sizeof(int);

  op_assert(l1_offset <= MAX_L1, "l1 buffer overflow");
  op_assert(l2_offset <= MAX_L2, "l2 buffer overflow");
  tops::mdspan l1_topk_ids(tops::Local, l1_topk_ids_buf, num_topk_ids_tile);

  tops::mdspan l1_is_in_rank(tops::Local, l1_is_in_rank_buf,
                             num_is_in_rank_tile);

  tops::mdspan l2_num_tokens_per_rank(tops::Shared, l2_tokens_per_rank_buf,
                                      num_tokens_per_rank_tile);

  tops::mdspan l3_topk_ids(tops::Global, topk_ids, num_tokens * num_topk);
  tops::mdspan l3_is_in_rank(tops::Global, is_token_in_rank,
                             num_tokens * num_ranks);

  const int num_experts_per_rank = num_experts / num_ranks;

  tops::memset(in_dte, l2_num_tokens_per_rank, 0);
  for (int token_offset = thread_token_begin + sub_id * sub_tokens;
       token_offset < thread_token_end; token_offset += (num_subs)*sub_tokens) {
    int act_tokens = std::min(thread_token_end - token_offset, sub_tokens);
    int pad_value = -1;
    // L1_VDMEM_LOAD
    tcle::fence<0x52>();
    tops::memset(in_dte, l1_is_in_rank, 0);
    tops::memset(in_dte, l1_topk_ids, pad_value);
    tops::mdspan l1_topk_ids_act(tops::Local, l1_topk_ids_buf,
                                 act_tokens * num_topk);
    tops::mdspan l3_topk_ids_act(tops::Global,
                                 topk_ids + token_offset * num_topk,
                                 act_tokens * num_topk);
    tops::memcpy(in_dte, l1_topk_ids_act, l3_topk_ids_act);

    int pad_offset =
        (num_subs - sub_id) * num_is_in_rank_tile * sizeof(uint8_t);
    scatter_is_in_slot_unroll_t<UNROLL_K>(l1_topk_ids_buf, l1_is_in_rank_buf,
                                          num_topk, sub_tokens, num_ranks,
                                          num_experts_per_rank, pad_offset);
    reduce_bool_unroll<UNROLL_R>(l1_is_in_rank_buf, l2_tokens_per_rank_buf,
                                 sub_tokens, num_ranks);
    if constexpr (STORE_IS_IN_RANK) {
      // sub_tokens, num_ranks
      tops::mdspan l1_is_in_rank_v(tops::Local, l1_is_in_rank_buf,
                                   act_tokens * num_ranks);
      tops::deslice(in_dte, l3_is_in_rank, l1_is_in_rank_v,
                    {token_offset * num_ranks});
    }
  }
  // L2_MEM_STORE
  tcle::fence<0x94>();
  tops::sync_block_threads();

  if (thread_id == 0 && sub_id == 0) {
    merge_total_and_store(l2_tokens_per_rank_buf, num_tokens_per_rank,
                          num_tokens_per_rank_tile, num_ranks,
                          num_threads * num_subs, 0, num_ranks);
  }
}

template <HIS_MODE MODE, int UNROLL_K, int UNROLL_R>
__global__ void
get_dispatch_layout_opt(int64_t *topk_idx,
                        //__global__ __cooperative__  void
                        //get_dispatch_layout_opt(int64_t* topk_idx,
                        int *num_tokens_per_rank, int *num_tokens_per_rdma_rank,
                        int *num_tokens_per_expert, bool *is_token_in_rank,
                        int num_tokens, int num_topk, int num_ranks,
                        int num_rdma_ranks, int num_experts) {
  const int block_id = static_cast<int>(blockIdx.x);
  const int num_blocks = static_cast<int>(gridDim.x);
  extern __shared__ __valigned__ char l2_buffer[];
  __local__ __valigned__ char l1_buffer[MAX_L1];
  //__syncthreads();
  tops::private_dte in_dte;
  in_dte.init();
  int *topk_idx_recast = reinterpret_cast<int *>(topk_idx);

  if (num_blocks <= 2) {
    handle_expert_histogram<MODE, UNROLL_K>(
        l1_buffer, l2_buffer, topk_idx_recast, num_tokens_per_expert,
        num_tokens, num_topk, num_experts, in_dte, block_id, num_blocks);
  } else {
    // only use 0 1 block
    if (block_id < 2) {
      handle_expert_histogram<MODE, UNROLL_K>(
          l1_buffer, l2_buffer, topk_idx_recast, num_tokens_per_expert,
          num_tokens, num_topk, num_experts, in_dte, block_id, 2);
    }
  }
  if (num_blocks <= 2) {
    // reuse l1 l2
    tcle::fence<0>();
    tops::sync_block_threads();
  }

  int rdma_block_id = 0;
  int rank_block_id = 0;
  if (num_blocks == 2) {
    rdma_block_id = 0;
    rank_block_id = 1;
  } else if (num_blocks == 3) {
    rdma_block_id = 2;
    rank_block_id = 2;
  } else {
    rdma_block_id = 2;
    rank_block_id = 3;
  }

  if (block_id == rank_block_id) {
    handle_rank<true, UNROLL_K, UNROLL_R>(l1_buffer, l2_buffer, topk_idx_recast,
                                          num_tokens_per_rank, is_token_in_rank,
                                          num_tokens, num_topk, num_experts,
                                          num_ranks, in_dte, 0, 1);
  }

  if (rank_block_id == rdma_block_id) {
    // reuse l1 l2
    tcle::fence<0>();
    tops::sync_block_threads();
  }

  if (num_tokens_per_rdma_rank) {
    if (block_id == rdma_block_id) {
      handle_rank<false, UNROLL_K, 1>(l1_buffer, l2_buffer, topk_idx_recast,
                                      num_tokens_per_rdma_rank, nullptr,
                                      num_tokens, num_topk, num_experts,
                                      num_rdma_ranks, in_dte, 0, 1);
    }
  }
}

void get_dispatch_layout(int64_t *topk_idx, int *num_tokens_per_rank,
                         int *num_tokens_per_rdma_rank,
                         int *num_tokens_per_expert, bool *is_token_in_rank,
                         int num_tokens, int num_topk, int num_ranks,
                         int num_experts, int num_rdma_ranks, int num_device_sms,
                         int max_threads_per_sm,
                         topsStream_t stream) {
  if (num_ranks <= 256 && num_topk <= 32) {
    SETUP_LAUNCH_CONFIG(num_device_sms, max_threads_per_sm, 4, stream);
    auto kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 1, 1>);
    if (num_topk == 8) {
      kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 8, 1>);
    }
    int smem_size = MAX_L2;
    cfg.dynamicSmemBytes = smem_size;
    // TODO (remove hard code) 
    // int num_rdma_ranks = num_ranks / num_rdma_ranks;
    LAUNCH_KERNEL(&cfg, kernel, topk_idx, num_tokens_per_rank,
                  num_tokens_per_rdma_rank, num_tokens_per_expert,
                  is_token_in_rank, num_tokens, num_topk, num_ranks,
                  num_rdma_ranks, num_experts);
  }
}

void test_get_dispatch_layout(int64_t *topk_idx, int *num_tokens_per_rank,
                              int *num_tokens_per_rdma_rank,
                              int *num_tokens_per_expert,
                              bool *is_token_in_rank, int num_tokens,
                              int num_topk, int num_ranks, int num_rdma_ranks,
                              int num_experts, topsStream_t stream) {
  if (num_ranks <= 256 && num_topk <= 32) {
    SETUP_LAUNCH_CONFIG(4, 6, 4, stream);
    auto kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 1, 1>);
    if (num_ranks % 8 != 0) {
      if (num_topk == 8) {
        kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 8, 1>);
      } else {
        kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 1, 1>);
      }
    } else {
      if (num_topk == 8) {
        kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 8, 8>);
      } else {
        kernel = (get_dispatch_layout_opt<HIS_MODE::SCATTER, 1, 8>);
      }
    }
    int smem_size = MAX_L2;
    cfg.dynamicSmemBytes = smem_size;
    LAUNCH_KERNEL(&cfg, kernel, topk_idx, num_tokens_per_rank,
                  num_tokens_per_rdma_rank, num_tokens_per_expert,
                  is_token_in_rank, num_tokens, num_topk, num_ranks,
                  num_rdma_ranks, num_experts);
  }
}

} // namespace layout

